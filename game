# ======================================================
# WORLD GENERATION
# ======================================================
def create_tree(x, z):
    trunk = Entity(
        model='cube',
        texture='brick',
        color=color.rgb(117, 69, 30),
        position=(x, 1.5, z),
        scale=(1, 3, 1),
        collider='box'
    )
    leaves = Entity(
        model='cube',
        texture='grass',
        color=color.rgb(40, 140, 50),
        position=(x, 4, z),
        scale=(3, 3, 3),
        collider='box'
    )
    trees.append((trunk, leaves))

for _ in range(40):
    rx, rz = random.uniform(-60, 60), random.uniform(-60, 60)
    if abs(rx) > 8 or abs(rz - 10) > 8:
        create_tree(rx, rz)

def create_diamond(x, z):
    d = Entity(
        model='octahedron',
        color=color.cyan,
        position=(x, 0.9, z),
        scale=1.2
    )
    diamonds.append(d)

for _ in range(10):
