# ======================================================
# PLAYER CONTROLS & ACTIONS
# ======================================================
def input(key):
    # Hotbar number key selection
    if key in ('1', '2', '3', '4'):
        set_selected_slot(int(key) - 1)
        
    # Scroll wheel selection
    if key == 'scroll up':
        set_selected_slot(selected_block_index - 1)
    if key == 'scroll down':
        set_selected_slot(selected_block_index + 1)

    if key == 'left mouse down' or key == 'f':
        fire_blaster()
    if key == 'right mouse down' or key == 'e':
        mine_resource()
    if key == 'q':
        build_block()
    if key == 'c':
        craft_block()

def mine_resource():
    for tree in trees[:]:
        trunk, leaves = tree
        if distance(player.position, trunk.position) < 4.5:
            snd_mine.play()
            destroy(trunk)
            destroy(leaves)
            trees.remove(tree)
            player_stats['wood'] += 2
            show_message("🪵 +2 WOOD")
            update_ui()
            return

    for d in diamonds[:]:
        if distance(player.position, d.position) < 3.5:
            snd_mine.play()
            destroy(d)
            diamonds.remove(d)
            player_stats['diamonds'] += 1
            show_message("💎 DIAMOND COLLECTED!")
            update_ui()
            return

def craft_block():
    if player_stats['wood'] >= 2:
        player_stats['wood'] -= 2
        player_stats['blocks'] += 1
        show_message("🧱 CRAFTED 1 BLOCK")
    else:
        show_message("❌ NEED 2 WOOD TO CRAFT")
    update_ui()

def build_block():
    if player_stats['blocks'] <= 0:
        show_message("❌ NO BLOCKS")
        return
    
    snd_mine.play()
    spawn_pos = player.position + player.forward * 3
    selected_type = BLOCK_TYPES[selected_block_index]
    
    block = Entity(
        model='cube',
        texture=selected_type["texture"],
        color=selected_type["color"],
        position=(round(spawn_pos.x / 2) * 2, 1, round(spawn_pos.z / 2) * 2),
        scale=2,
        collider='box'
    )
    placed_blocks.append(block)
    player_stats['blocks'] -= 1
    show_message(f"Placed {selected_type['name']} Block")
    update_ui()

def fire_blaster():
    if player_stats['ammo'] <= 0:
        show_message("❌ OUT OF AMMO")
        return

    snd_shoot.play()
    player_stats['ammo'] -= 1
    bullet = Entity(
        model='sphere',
        color=color.cyan,
        position=player.position + Vec3(0, 1.5, 0),
        scale=0.3
    )
    bullet.velocity = player.forward * 40
    bullets.append(bullet)
    update_ui()

# ======================================================
# GAME LOOP
# ======================================================
game_time = 0
alien_timer = 0
dragon_timer = 0
is_night = False

def update():
    global game_time, alien_timer, dragon_timer, is_night, ufo, dragon, dragon_health

    game_time += time.dt * 0.2
    
    # Day / Night
    if math.sin(game_time) < -0.2 and not is_night:
        is_night = True
        sky.color = color.rgb(12, 16, 32)
        for _ in range(3): spawn_alien()
        show_message("🌙 NIGHT HAS FALLEN!")

    elif math.sin(game_time) > 0.2 and is_night:
        is_night = False
        sky.color = color.rgb(120, 185, 232)
        show_message("☀️ DAYBREAK!")

    # Aliens AI
    for alien in aliens:
        dist = distance(player.position, alien.position)
        if dist > 1.5:
            alien.look_at(player.position)
            alien.position += alien.forward * time.dt * 2.5
        else:
            player_stats['health'] -= time.dt * 10
            update_ui()

    # Bullets logic
    for b in bullets[:]:
        b.position += b.velocity * time.dt
        
        for alien in aliens[:]:
            if distance(b.position, alien.position) < 1.5:
                snd_hit.play()
                destroy(alien)
                aliens.remove(alien)
                destroy(b)
                if b in bullets: bullets.remove(b)
                show_message("👽 ALIEN DEFEATED!")
                break
                
        if dragon and distance(b.position, dragon.position) < 4:
            snd_hit.play()
            dragon_health -= 10
            destroy(b)
            if b in bullets: bullets.remove(b)
            if dragon_health <= 0:
                destroy(dragon)
                dragon = None
                show_message("🏆 DRAGON DEFEATED!")

        if distance(b.position, player.position) > 100:
            destroy(b)
            if b in bullets: bullets.remove(b)

    # Event Spawns
    alien_timer += time.dt
    if alien_timer > 30:
        alien_timer = 0
        spawn_ufo()

    if ufo:
        if distance(player.position, ufo.position) < 5:
            player_stats['ammo'] += 10
            destroy(ufo)
            ufo = None
            show_message("🔫 ALIEN ENERGY +10 AMMO")
            update_ui()

    dragon_timer += time.dt
    if dragon_timer > 60 and not dragon:
        dragon_timer = 0
        spawn_dragon()

    if dragon:
        dragon.look_at(player.position)
        dragon.position += dragon.forward * time.dt * 1.5

    # Game Over
    if player_stats['health'] <= 0:
        show_message("💀 GAME OVER")
        player_stats['health'] = 100
        player.position = (0, 2, 10)
        update_ui()

Text(
    text="WASD: Move | Mouse: Look | 1-4 / Scroll: Select Block | Q: Build | C: Craft | Left Click: Shoot | Right Click: Mine",
