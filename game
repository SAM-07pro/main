# ======================================================
# PROCEDURAL AUDIO GENERATOR (NO EXTERNAL FILES REQUIRED)
# ======================================================
def generate_sound(filename, sound_type):
    sample_rate = 44100
    num_samples = int(sample_rate * 0.15)
    audio = []

    for i in range(num_samples):
        t = i / sample_rate
        if sound_type == "shoot":
            freq = 800 * (1 - t / 0.15)
            val = math.sin(2 * math.pi * freq * t)
        elif sound_type == "mine":
            freq = 150 + random.uniform(-30, 30)
            val = math.sin(2 * math.pi * freq * t) * (1 - t / 0.15)
        elif sound_type == "hit":
            freq = 250
            val = 0.5 if (int(t * freq * 2) % 2 == 0) else -0.5
            val *= (1 - t / 0.15)
        
        sample = int(max(-1.0, min(1.0, val)) * 32767)
        audio.append(struct.pack('<h', sample))

    with wave.open(filename, 'wb') as wav_file:
        wav_file.setnchannels(1)
        wav_file.setsampwidth(2)
        wav_file.setframerate(sample_rate)
        wav_file.writeframes(b''.join(audio))

generate_sound("sfx_shoot.wav", "shoot")
generate_sound("sfx_mine.wav", "mine")
generate_sound("sfx_hit.wav", "hit")


